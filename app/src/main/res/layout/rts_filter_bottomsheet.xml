<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/con_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/con"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10DP"
                android:background="@color/white"
                android:padding="@dimen/_16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/mi_filter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_filter"
                    style="@style/subheading"
                    android:layout_marginStart="@dimen/_5DP"
                    android:text="@string/filter"
                    android:textSize="@dimen/_16SP"
                    android:tint="@color/black_1A"
                    app:layout_constraintLeft_toRightOf="@+id/filter"
                    app:layout_constraintTop_toTopOf="parent" />


                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_7DP"
                    android:src="@drawable/close"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@color/light_grey_ec"
                app:layout_constraintTop_toBottomOf="@+id/con"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/conMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1DP"
                android:background="@color/white"
                android:paddingStart="@dimen/_16DP"
                android:paddingEnd="@dimen/_16DP"
                app:layout_constraintTop_toBottomOf="@+id/con">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/con1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10DP"
                    android:background="@color/white"
                    android:paddingBottom="@dimen/_15DP"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.4">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sort"
                        style="@style/subheading"
                        android:gravity="start"
                        android:text="Sort By"
                        android:textSize="@dimen/_16SP"
                        android:tint="@color/black_1A"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <View
                        android:id="@+id/viewSort"
                        android:layout_width="3dp"
                        app:layout_constraintTop_toTopOf="@id/sort"
                        app:layout_constraintBottom_toBottomOf="@id/sort"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:background="@color/blue_18"
                        android:layout_height="0dp"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/dateRange"
                        style="@style/subheading"
                        android:gravity="start"
                        android:text="Date Range"
                        android:textSize="@dimen/_16SP"
                        android:tint="@color/black_1A"
                        android:layout_marginTop="@dimen/_20DP"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sort" />
                    <View
                        android:id="@+id/viewDateRange"
                        android:layout_width="3dp"
                        app:layout_constraintTop_toTopOf="@id/dateRange"
                        app:layout_constraintBottom_toBottomOf="@id/dateRange"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:background="@color/blue_18"
                        android:visibility="gone"
                        android:layout_height="0dp"/>



                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/view"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="@color/light_grey_ec"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/con1"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/con2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:minHeight="200dp"
                    app:layout_constraintStart_toEndOf="@+id/view"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    >


                    <RadioGroup
                        android:layout_marginStart="@dimen/_15DP"
                        android:id="@+id/group_sort_by"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:layout_marginTop="@dimen/_5DP"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <RadioButton
                            android:buttonTint="@color/black_1A"
                            android:id="@+id/new_to_old"
                            android:paddingLeft="@dimen/_8DP"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/newest_to_oldest"

                            android:textColor="@color/black"/>

                        <RadioButton
                            android:id="@+id/old_to_new"
                            android:paddingLeft="@dimen/_8DP"
                            android:buttonTint="@color/black_1A"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/oldest_to_newest"
                            android:textColor="@color/black"/>
                    </RadioGroup>
                    <RadioGroup
                        android:id="@+id/group_date_range"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:visibility="gone"
                        android:layout_marginTop="@dimen/_5DP"
                        android:layout_marginStart="@dimen/_15DP"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        <RadioButton
                            android:id="@+id/today"
                            android:buttonTint="@color/black_1A"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/_8DP"
                            android:text="@string/today"
                            android:textColor="@color/black"/>
                        <RadioButton
                            android:id="@+id/last_7_dates"
                            android:buttonTint="@color/black_1A"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/_8DP"
                            android:text="@string/last_7_days"
                            android:textColor="@color/black"/>
                        <RadioButton
                            android:id="@+id/last_15_days"
                            android:buttonTint="@color/black_1A"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_15_days"
                            android:paddingLeft="@dimen/_8DP"
                            android:textColor="@color/black"/>
                        <RadioButton
                            android:id="@+id/custom_date"
                            android:buttonTint="@color/black_1A"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/_8DP"
                            android:text="@string/custom_date"
                            android:textColor="@color/black"/>

                    </RadioGroup>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/constraint_customDate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toBottomOf="@+id/group_date_range"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginStart="@dimen/_17DP"
    app:layout_constraintEnd_toEndOf="parent"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="parent">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/fromDate"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10DP"
        android:hint="From"
        android:textColorHint="@color/editext_border_color"
        android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
        app:boxStrokeColor="@color/editext_border_color"
        app:hintTextColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/RoundedCorners">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFromDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:inputType="text"
            android:maxLines="1"
            android:focusable="false"
            android:textColor="@color/black_1A"
            android:textSize="@dimen/_13SP" />

    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/toDate"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10DP"
        android:hint="To"
        android:textColorHint="@color/editext_border_color"
        android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
        app:boxStrokeColor="@color/editext_border_color"
        app:hintTextColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fromDate"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/_15DP"
        app:shapeAppearance="@style/RoundedCorners">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etToDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:inputType="text"
            android:maxLines="1"
            android:focusable="false"
            android:enabled="false"
            android:textColor="@color/black_1A"
            android:textSize="@dimen/_13SP" />

    </com.google.android.material.textfield.TextInputLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/viewBottom"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/light_grey_ec"
                app:layout_constraintTop_toBottomOf="@+id/conMain"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@color/white"
                android:paddingTop="@dimen/_15DP"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/conMain">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCancel"
                    style="@style/buttoncommonstyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_55DP"
                    android:layout_marginStart="@dimen/_16DP"
                    android:layout_marginEnd="@dimen/_15DP"
                    android:layout_marginBottom="@dimen/_20DP"
                    android:background="@drawable/clear_filter"
                    android:text="Clear"
                    android:textColor="@color/blue_FC"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnApply"

                     />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnApply"
                    style="@style/buttoncommonstyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_55DP"
                    android:layout_marginStart="@dimen/_16DP"
                    android:layout_marginEnd="@dimen/_16DP"
                    android:layout_marginBottom="@dimen/_20DP"
                    android:background="@drawable/custom_button_10dp"
                    android:text="@string/apply"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.45" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
