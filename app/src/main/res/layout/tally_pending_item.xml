<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/itemCl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_10DP"
        android:paddingHorizontal="@dimen/_20DP"
        android:background="@color/white">
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/selectCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_15DP"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/awb"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"
            app:buttonIcon="@drawable/custom_checkbox"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/awb"
            android:layout_width="@dimen/_0DP"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/selectCheckbox"
            app:layout_constraintTop_toTopOf="@id/selectCheckbox"
            app:layout_constraintBottom_toBottomOf="@id/selectCheckbox"
            app:layout_constraintEnd_toStartOf="@id/orderType"
            style="@style/subheading"
            android:text="@string/awb_2036456682"
            android:textSize="@dimen/_18SP"/>
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/orderType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/awb"
            app:layout_constraintTop_toTopOf="@id/selectCheckbox"
            app:layout_constraintBottom_toBottomOf="@id/selectCheckbox"
            style="@style/subheading"
            android:text="FWD"
            android:textSize="@dimen/_21SP"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2DP"
            app:layout_constraintTop_toBottomOf="@id/awb"
            android:layout_marginTop="@dimen/_15DP"
            android:background="@color/sky_FF"/>



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>