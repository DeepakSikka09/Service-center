<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="otpCornerStyle" parent="@style/Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/allsidecorner</item>
    </style>

    <style name="otpsheetDialogTheme" parent="@style/Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/otpCornerStyle</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="custombutton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/_10DP</item>
        <item name="android:textSize">@dimen/_18SP</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">@dimen/_10DP</item>
        <item name="backgroundTint">@color/disable_btn</item>
    </style>

    <style name="buttoncommonstyle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/_10DP</item>
        <item name="android:textSize">@dimen/_21SP</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">@dimen/_10DP</item>
        <item name="android:background">@drawable/custom_button_10dp</item>
    </style>

    <style name="customNewButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/_20DP</item>
        <item name="android:textSize">@dimen/_21SP</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">@dimen/_6DP</item>
        <item name="backgroundTint">@color/gray</item>
    </style>

    <style name="title_text_style" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black_1A</item>
        <item name="android:textSize">@dimen/_21SP</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="title_text_style2" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black_1A</item>
        <item name="android:textSize">@dimen/_21SP</item>
        <item name="fontFamily">@font/roboto_medium</item>
    </style>

    <style name="subheading" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black_1A</item>
        <item name="android:textSize">@dimen/_18SP</item>
        <item name="fontFamily">@font/roboto_medium</item>
    </style>
    <style name="heading" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black_1A</item>
        <item name="android:textSize">@dimen/_21SP</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="toolbarTitle" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black_1A</item>
        <item name="android:textSize">@dimen/_21SP</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>
    <style name="description_text_style" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black_1A</item>
        <item name="android:textSize">@dimen/_14SP</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="description_text_style2" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black_1A</item>
        <item name="android:textSize">@dimen/_18SP</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="CornerCut" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/_10DP</item>
        <item name="cornerSizeTopRight">@dimen/_10DP</item>
        <item name="cornerSizeBottomLeft">@dimen/_10DP</item>
        <item name="cornerSizeBottomRight">@dimen/_10DP</item>
    </style>


    <style name="SingleNumberEditText">
        <item name="android:gravity">center</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:inputType">number</item>
        <item name="android:layout_width">@dimen/_50DP</item>
        <item name="android:layout_height">@dimen/_50DP</item>
    </style>

    <style name="CustomProgressBarStyle" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/custom_progressbar_horizontal</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
    </style>

    <style name="service_text_style" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_25DP</item>
        <item name="android:layout_marginStart">@dimen/_20DP</item>
        <item name="android:textColor">@color/black_1A</item>
        <item name="android:textSize">@dimen/_21SP</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="TextInputLayoutStyleOutline">
        <item name="errorEnabled">true</item>
        <item name="hintEnabled">false</item>
        <item name="background">@color/transparent</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="ThemeOverlay.AppTheme.TextInputEditText.Outlined" parent="">
        <item name="colorControlActivated">@color/black</item>
    </style>

    <style name="RoundedCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_5DP</item>
    </style>
    <style name="AppCompatAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/primary_color</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:background">@color/white</item>
    </style>
    <style name="CustomSearchViewStyle" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:textColor">@color/black</item>
        <item name="android:textCursorDrawable">@drawable/custom_cursor</item>
        <item name="android:inputType">number</item>
        <item name="android:textColorHint">@color/grey_478</item>

    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
    </style>

    <style name="bottomSheetBackground" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/con_bg</item>
    </style>

    <style name="menuItemStyle" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="android:backgroundTint">@color/blue_7FE</item>
        <item name="android:textColor">@color/black_1A</item>
        <item name="android:textSize">@dimen/_18SP</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:dropDownListViewStyle">@style/PopupMenuListView</item>
    </style>
    <style name="PopupMenuListView" parent="@style/Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">#F6F8FF</item>
        <item name="android:dividerHeight">1dp</item>
    </style>
</resources>

